{
  "name": "tally-nfl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tally NFL companion — spoiler-safe second-screen for football, sharing the Tally brand/design system with Tally Baseball.",
  "scripts": {
    "dev": "vite",
    "dev:2": "vite --port 5175",
    "dev:3": "vite --port 5176",
    "dev:4": "vite --port 5177",
    "dev:5": "vite --port 5178",
    "build": "vite build",
    "preview": "vite preview",
    "preview:2": "vite preview --port 4175",
    "preview:3": "vite preview --port 4176",
    "preview:4": "vite preview --port 4177",
    "preview:5": "vite preview --port 4178",
    "lint": "eslint . && node scripts/check-claude-md.mjs",
    "data:nflverse": "node scripts/fetch-nflverse.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "vite": "^6.0.7"
  }
}
